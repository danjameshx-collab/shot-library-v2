# Copy to .env and fill in. .env is git-ignored: never commit your key.
# Close: Settings > Developer > API Keys > + New API Key
CLOSE_API_KEY=paste-your-close-api-key-here

# 0 = pull tasks due today or late (default). 1 = also tomorrow's, and so on.
LOOKAHEAD_DAYS=0

# true = every user's tasks, not just the ones assigned to you
CLOSE_ALL_USERS=false
